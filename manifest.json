{
  "manifest_version": 3,
  "name": "DraftPilot for Skool",
  "version": "1.0.0",
  "description": "Draft replies to Skool posts and comments with your own Anthropic API key.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.skool.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.skool.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
